# ============================================================
# Backend / SAM Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.
# These are used by SAM CLI locally (sam local start-api).
# In production, values come from SAM parameter overrides or
# AWS Secrets Manager.
# ============================================================

# ── AWS Account & Region ─────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# ── SAM Stack Parameters ─────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-before-deploy
ADMIN_API_KEY=your-secret-admin-key-min-32-chars
STAGE_NAME=Prod

# Optional Cognito Hosted UI / Google federation parameters.
COGNITO_DOMAIN_PREFIX=your-unique-cognito-domain-prefix
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_CALLBACK_URLS=http://localhost:5173/
OAUTH_LOGOUT_URLS=http://localhost:5173/

# ── DynamoDB (local testing) ─────────────────────────────────
DYNAMODB_ENDPOINT=http://localhost:8000    # Only for local DynamoDB
WAITING_ROOM_TABLE=WaitingRoom-dev
SEAT_PURCHASE_TABLE=SeatPurchase-dev
CONCESSIONS_TABLE=ConcessionsTable
LEADERBOARD_TABLE=LeaderboardTable

# ── EventBridge ──────────────────────────────────────────────
EVENTBRIDGE_BUS_NAME=GlobalSportingEventsBus

# ── Stripe (Lambda secret) ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
