# ============================================================
# Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.
# ============================================================

# ── AWS API Gateway ──────────────────────────────────────────
# Waiting Room API Gateway URL (from sam deploy outputs: WaitingRoomApiUrl)
VITE_API_BASE_URL=https://your-waiting-room-api-id.execute-api.us-east-1.amazonaws.com/Prod

# Seat Purchase API Gateway URL (from sam deploy outputs: SeatPurchaseApiUrl)
VITE_SEAT_PURCHASE_API_URL=https://your-seat-purchase-api-id.execute-api.us-east-1.amazonaws.com/Prod
VITE_CONCESSIONS_API_URL=https://your-concessions-api-id.execute-api.us-east-1.amazonaws.com/Prod
VITE_LEADERBOARD_API_URL=https://your-leaderboard-api-id.execute-api.us-east-1.amazonaws.com/Prod

# ── AWS Cognito ──────────────────────────────────────────────
# From sam deploy outputs
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_OAUTH_DOMAIN=
VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173/
VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173/

# ── Google OAuth ─────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
# Google OAuth is configured through Cognito/SAM, not directly in the browser.

# ── Stripe ───────────────────────────────────────────────────
# Publishable key only — secret key stays in Lambda env vars
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key

# ── Admin Portal (must match SAM AdminEmail + AdminPassword parameters) ───────
VITE_ADMIN_EMAIL=admin@gsep.com
VITE_ADMIN_PASSWORD=admin123!
VITE_ADMIN_API_KEY=replace-with-real-key

# ── Feature flags ────────────────────────────────────────────
# Set to "true" to use real API instead of localStorage mock
VITE_USE_REAL_API=false
